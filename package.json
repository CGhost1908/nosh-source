{
  "name": "nosh",
  "version": "1.4.0",
  "description": "High-craft note & code workstation for developers and thinkers",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir",
    "check": "node scripts/check-syntax.js",
    "test:e2e": "node tests/run-e2e.js",
    "test": "npm run check && npm run test:e2e"
  },
  "build": {
    "icon": "icon.ico",
    "appId": "com.myapp.desktop",
    "files": [
      "**/*",
      "!**/.env*",
      "!client_secret*.json",
      "!*.pem",
      "!*.key",
      "!setup.iss",
      "!scratch/**",
      "!tests/**",
      "!scripts/**",
      "!*.md",
      "!start.bat",
      "!src/*.psd"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "codemirror": "^5.65.18",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "highlight.js": "^11.10.0",
    "interactjs": "^1.10.27"
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "playwright": "^1.64.1"
  }
}
